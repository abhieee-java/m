<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_alignParentStart="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Contact"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/ndot"
                android:layout_centerInParent="true" />

            <TextView
                android:id="@+id/btn_save_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/bg_floating_pill"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit picture"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_floating_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_pill"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            
            <EditText
                android:id="@+id/input_first_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:hint="First Name"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="12dp" />
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />
            
            <EditText
                android:id="@+id/input_surname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:hint="Surname"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingStart="52dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_pill"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            
            <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                <EditText
                    android:id="@+id/input_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Number"
                    android:inputType="phone"
                    android:textColorHint="#888888"
                    android:textColor="#FFFFFF"
                    android:paddingStart="16dp"
                    android:drawableStart="@android:drawable/ic_menu_call"
                    android:drawablePadding="12dp" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_floating_pill"
                    android:backgroundTint="#FFC107"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </RelativeLayout>
            
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />
            
            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:hint="Mobile"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:drawableStart="@android:drawable/arrow_down_float"
                android:drawablePadding="12dp"
                android:focusable="false"
                android:clickable="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_floating_pill"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            
            <EditText
                android:id="@+id/input_company"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:hint="Company"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:drawableStart="@android:drawable/ic_menu_view"
                android:drawablePadding="12dp" />
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />
            
            <EditText
                android:id="@+id/input_job_title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent"
                android:hint="Job Title"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingStart="52dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
